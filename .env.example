# VantageNet Environment Configuration
# Copy this file to .env and update values as needed

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=vantage
POSTGRES_PASSWORD=vantage_secret
POSTGRES_DB=vantage_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6380

# ============================================
# API Gateway Configuration
# ============================================
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=8000

# ============================================
# Local Python Services Configuration
# These services run on your local machine (my_env)
# ============================================
VIDEO_INGESTION_HOST=localhost
VIDEO_INGESTION_PORT=8001

EMOTION_DETECTION_HOST=localhost
EMOTION_DETECTION_PORT=8002

SENTIMENT_ANALYSIS_HOST=localhost
SENTIMENT_ANALYSIS_PORT=8003

# ============================================
# Python Virtual Environment
# Path to your local PyTorch environment
# ============================================
PYTHON_VENV_PATH=~/my_env

# ============================================
# Dashboard Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
